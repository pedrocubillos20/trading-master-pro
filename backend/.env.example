# Trading Master Pro v25.0 - Variables de entorno
# =============================================

# Puerto (Railway lo asigna automáticamente)
PORT=3001

# Deriv WebSocket App ID
DERIV_APP_ID=1089

# OpenAI API Key — para análisis IA institucional
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Supabase — usuarios y suscripciones
# Obtener en: https://app.supabase.com/project/xxx/settings/api
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Telegram (opcional — solo para notificaciones manuales)
TELEGRAM_BOT_TOKEN=123456:ABC-xxx
TELEGRAM_CHAT_ID=-1001234567890
